FROM pytorch/pytorch:2.12.1-cuda12.6-cudnn9-devel

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/models/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PYTHONPATH=/app/src:/app/scripts

WORKDIR /app
COPY . /app

# Keep the CUDA-enabled PyTorch supplied by the base image.
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir -e '.[serve]' \
      'transformers>=5.3,<6' 'peft>=0.15' 'safetensors>=0.5' 'accelerate>=1.0' && \
    python -m pip install --no-cache-dir 'einops' 'ninja' && \
    python -m pip install --no-cache-dir --no-deps \
      'fla-core==0.5.2' 'flash-linear-attention==0.5.2' && \
    python -m pip install --no-cache-dir --no-build-isolation \
      'causal-conv1d==1.7.0' && \
    python -c "import torch, fla, causal_conv1d; from fla.ops.gated_delta_rule import chunk_gated_delta_rule; assert torch.version.cuda, 'Expected CUDA PyTorch'; print('CUDA FLA and causal-conv1d kernels imported with', torch.__version__, torch.version.cuda)"

EXPOSE 8765
CMD ["python", "/app/docker/entrypoint.py"]
